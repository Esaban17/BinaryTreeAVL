# Configuración de MongoDB Atlas
# Copia este archivo como .env y completa con tus credenciales reales.
#
# Cualquiera de estas variables puede definirse también como variable de entorno
# del sistema; en ese caso la variable de entorno tiene prioridad sobre el .env.
# Se admiten comentarios (#), el prefijo "export" y valores entre comillas.

# --- Obligatorio ---

# URI de conexión a MongoDB Atlas
# Formato: mongodb+srv://usuario:contraseña@cluster.mongodb.net/
MONGODB_URI=mongodb+srv://tu-usuario:tu-contraseña@tu-cluster.mongodb.net/

# --- Opcionales (se muestran con sus valores por defecto) ---

# Nombre de la base de datos
DATABASE_NAME=avltree

# Nombre de la colección para almacenar los nodos del árbol
COLLECTION_NAME=nodes

# Timeout de conexión y de selección de servidor, en milisegundos
CONNECTION_TIMEOUT=10000

# Timeout de lectura del socket, en milisegundos
SOCKET_TIMEOUT=10000

# Número máximo de intentos de conexión al arrancar
MAX_CONNECTION_RETRIES=5

# Espera entre intentos de conexión, en milisegundos
RETRY_INTERVAL=2000

# El nivel de log NO se configura aquí: se define en
# src/main/resources/logback.xml
